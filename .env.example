# WebUntis Configuration
WEBUNTIS_SERVER=your-server.webuntis.com
WEBUNTIS_SCHOOL=your-school-name
WEBUNTIS_USERNAME=your-username
WEBUNTIS_PASSWORD=your-password

# Server Configuration
PORT=3979

# Google Calendar destination
GOOGLE_CALENDAR_ID=your-calendar-id@group.calendar.google.com

# Full JSON for your service account credentials as a single line
GOOGLE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"your-project",...}

# Optional timezone for inserted events
CALENDAR_TIMEZONE=Europe/Berlin

# Optional update interval in minutes
CALENDAR_UPDATE_INTERVAL_MINUTES=10
